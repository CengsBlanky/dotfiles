#!/usr/bin/env bash
# doubao-cli: Chat with Doubao API via curl + jq + glow

set -euo pipefail

MODEL="doubao-seed-2-0-pro-260215"
API_URL="https://ark.cn-beijing.volces.com/api/v3/chat/completions"

key_file="$HOME/.secrets/ark_api_key"
if [[ ! -f "$key_file" ]]; then
  echo "Error: API key file not found at $key_file" >&2
  exit 1
fi
ARK_API_KEY=$(cat "$key_file" | tr -d '[:space:]')

if [[ $# -lt 1 ]]; then
  echo "Usage: $0 <message>" >&2
  exit 1
fi

input="$*"

# Build request body
body=$(printf '{"model":"%s","reasoning_effort":"medium","messages":[{"role":"user","content":[{"type":"text","text":"%s"}]}]}' "$MODEL" "$(echo "$input" | sed 's/\\/\\\\/g; s/"/\\"/g')")

# Send request
response=$(curl -s --noproxy '*' \
  -X POST "$API_URL" \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer $ARK_API_KEY" \
  -d "$body") || {
  echo "Error: curl request failed." >&2
  exit 1
}

# Check for API error
if echo "$response" | jq -e '.error' >/dev/null 2>&1; then
  echo "API Error: $(echo "$response" | jq -r '.error.message')" >&2
  exit 1
fi

# Extract assistant content
content=$(echo "$response" | jq -r '.choices[0].message.content // empty' 2>/dev/null)
if [[ -z "$content" ]]; then
  echo "Error: empty response from API." >&2
  exit 1
fi

# Display formatted output
echo "$content" | glow
