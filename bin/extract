#!/bin/bash

# safe-extract: Extract archives into a dedicated folder
# Usage: ./safe-extract <file>

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

# Check if argument is provided
if [ $# -ne 1 ]; then
    echo -e "${RED}Error:${NC} Please provide a file name."
    echo "Usage: $0 <archive_file>"
    exit 1
fi

FILE="$1"

# Check if file exists
if [ ! -f "$FILE" ]; then
    echo -e "${RED}Error:${NC} File '$FILE' not found."
    exit 1
fi

# Determine base folder name by stripping extensions intelligently
BASENAME=$(basename "$FILE")
FOLDERNAME="$BASENAME"

# Handle common multi-part extensions
case "$BASENAME" in
*.tar.gz | *.tgz) FOLDERNAME="${BASENAME%.*}" && FOLDERNAME="${FOLDERNAME%.*}" ;;
*.tar.bz2) FOLDERNAME="${BASENAME%.*}" && FOLDERNAME="${FOLDERNAME%.*}" ;;
*.tar.xz) FOLDERNAME="${BASENAME%.*}" && FOLDERNAME="${FOLDERNAME%.*}" ;;
*.tar.7z) FOLDERNAME="${BASENAME%.*}" && FOLDERNAME="${FOLDERNAME%.*}" ;;
*.tar.Z) FOLDERNAME="${BASENAME%.*}" && FOLDERNAME="${FOLDERNAME%.*}" ;;
*.tar.lz) FOLDERNAME="${BASENAME%.*}" && FOLDERNAME="${FOLDERNAME%.*}" ;;
*.tar.lzma) FOLDERNAME="${BASENAME%.*}" && FOLDERNAME="${FOLDERNAME%.*}" ;;
*) FOLDERNAME="${BASENAME%.*}" ;;
esac

# Create the directory
echo "Creating directory: ./${FOLDERNAME}"
mkdir -p "$FOLDERNAME"

# Function to check if a command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Extraction logic based on file extension
case "$FILE" in
*.tar.gz | *.tgz)
    echo -e "${GREEN}Extracting${NC} $FILE (tar.gz) ..."
    tar -xzf "$FILE" -C "$FOLDERNAME"
    ;;
*.tar.xz)
    echo -e "${GREEN}Extracting${NC} $FILE (tar.xz) ..."
    tar -xJf "$FILE" -C "$FOLDERNAME"
    ;;
*.tar.bz2)
    echo -e "${GREEN}Extracting${NC} $FILE (tar.bz2) ..."
    tar -xjf "$FILE" -C "$FOLDERNAME"
    ;;
*.tar.7z)
    if ! command_exists 7z; then
        echo -e "${RED}Error:${NC} '7z' not found. Install p7zip-full."
        exit 1
    fi
    echo -e "${GREEN}Extracting${NC} $FILE (tar.7z) ..."
    7z x "$FILE" -so | tar -xf - -C "$FOLDERNAME"
    ;;
*.7z)
    if ! command_exists 7z; then
        echo -e "${RED}Error:${NC} '7z' not found. Install p7zip-full."
        exit 1
    fi
    echo -e "${GREEN}Extracting${NC} $FILE (7z) ..."
    7z x "$FILE" -o"$FOLDERNAME" >/dev/null
    ;;
*.tar)
    echo -e "${GREEN}Extracting${NC} $FILE (tar) ..."
    tar -xf "$FILE" -C "$FOLDERNAME"
    ;;
*.gz)
    echo -e "${GREEN}Extracting${NC} $FILE (gz) ..."
    gunzip -c "$FILE" >"$FOLDERNAME/$(basename "$FILE" .gz)"
    ;;
*.zip)
    echo -e "${GREEN}Extracting${NC} $FILE (zip) ..."
    unzip -q "$FILE" -d "$FOLDERNAME"
    ;;
*.bz2)
    echo -e "${GREEN}Extracting${NC} $FILE (bz2) ..."
    bunzip2 -c "$FILE" >"$FOLDERNAME/$(basename "$FILE" .bz2)"
    ;;
*.xz)
    echo -e "${GREEN}Extracting${NC} $FILE (xz) ..."
    unxz -c "$FILE" >"$FOLDERNAME/$(basename "$FILE" .xz)"
    ;;
*)
    echo -e "${RED}Error:${NC} Unsupported file format: $FILE"
    echo "Supported formats: .zip, .tar.gz, .tgz, .tar.bz2, .tar.xz, .tar.7z, .7z, .gz, .bz2, .xz, .tar"
    exit 1
    ;;
esac

# Check if extraction was successful
if [ $? -eq 0 ]; then
    echo -e "\n${GREEN}Success!${NC} Files extracted to: ./$FOLDERNAME"
else
    echo -e "\n${RED}Extraction failed.${NC} (Check if required tools are installed)"
    rmdir "$FOLDERNAME" 2>/dev/null || true
    exit 1
fi
