[global]
    monitor = 0
    follow = keyboard
    indicate_hidden = yes
    width = 600
    height = (0, 9000)
    corner_radius = 9
    offset = (0,21)
    notification_limit = 60
    shrink = no
    transparency = 10
    separator_height = 2
    padding = 8
    horizontal_padding = 8
    frame_width = 4
    sort = yes
    idle_threshold = 120
    font = "NotoSansDWM 12"
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = top
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no
    icon_position = off
    icon_path = ""
    mouse_left_click = close_current
    mouse_right_click = close_all
    frame_color = "#2e3440"
    separator_color= frame
    highlight = "#89b4fa"
    timeout = 10

[urgency_low]
    background = "#2e3440"
    foreground = "#cdd6f4"
    timeout = 6

[urgency_normal]
    background = "#2e3440"
    foreground = "#cdd6f4"

[urgency_critical]
    background = "#2e3440"
    foreground = "#cdd6f4"
    frame_color = "#fab387"
    timeout = 30
