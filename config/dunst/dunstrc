[global]
    monitor = 0
    follow = keyboard
    indicate_hidden = yes
    width = 600
    height = 9000
    corner_radius = 9
    offset = 0x32
    notification_limit = 60
    shrink = no
    transparency = 10
    separator_height = 2
    padding = 8
    horizontal_padding = 8
    frame_width = 4
    frame_color = "#868e96"
    separator_color = frame
    sort = yes
    idle_threshold = 120
    font = "Source Han Sans VF 15"
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = top
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    mouse_left_click = close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#4c566a"
    foreground = "#a3be8c"
    frame_color = "#a3be8c"
    highlight = "#a3be8c"
    timeout = 6

[urgency_normal]
    background = "#2E3440"
    foreground = "#dee2e6"
    frame_color = "#dee2e6"
    highlight = "#dee2e6"
    timeout = 10

[urgency_critical]
    background = "#2E3440"
    foreground = "#BF616A"
    frame_color = "#BF616A"
    highlight = "#BF616A"
    timeout = 30
