font-family="SauceCodePro Nerd Font"
font-family=TsangerJinKai05
font-style=SemiLight
font-size=14
# adjust-cell-width=-8%
# adjust-cell-height=-15%
font-feature=zero
adjust-underline-position=10%
# theme=Kanagawa Dragon
cursor-style=bar
cursor-style-blink=false
mouse-hide-while-typing=true
command=/usr/bin/fish
maximize=true
window-padding-y=0,0
window-inherit-working-directory=true
window-decoration=false
window-subtitle=working-directory
window-new-tab-position=end
resize-overlay=never
clipboard-trim-trailing-spaces=true
copy-on-select=clipboard
quick-terminal-position=center
shell-integration=fish
split-divider-color=008C8C
app-notifications=no-clipboard-copy
adw-toolbar-style=flat
gtk-tabs-location=bottom
gtk-wide-tabs=false
window-theme=ghostty

keybind = alt+equal=new_split:right
keybind = alt+minus=new_split:down
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+l=goto_split:right
keybind = alt+h=goto_split:left
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+k=scroll_page_up
keybind = ctrl+shift+j=scroll_page_down
keybind = ctrl+shift+h=scroll_to_top
keybind = ctrl+shift+l=scroll_to_bottom
keybind = ctrl+shift+t=new_tab
keybind = ctrl+q>t=new_tab
keybind = ctrl+q>c=new_tab
keybind = ctrl+q>l=previous_tab
keybind = alt+up=resize_split:up,128
keybind = alt+down=resize_split:down,128
keybind = alt+left=resize_split:left,128
keybind = alt+right=resize_split:right,128
keybind = ctrl+alt+w=close_surface
keybind = ctrl+q>x=close_tab
keybind = ctrl+alt+t=toggle_quick_terminal
