# Everforest colors for lf file manager
# Based on Everforest palette and 256-color ANSI approximations

# Default foreground color (fg)
# Hex: #D3C6AA -> ANSI 252 (light grey/beige)
# Default background color (bg0)
# Hex: #272E33 -> ANSI 236 (dark desaturated blue-grey)

# Directories (di) - green
di=38;5;107

# Symbolic links (ln) - aqua
ln=38;5;109

# Regular files (fi) - default foreground
fi=38;5;252

# Executable files (ex) - orange
ex=38;5;172

# Block device (bd) - yellow
bd=38;5;179

# Character device (cd) - yellow
cd=38;5;179

# Socket (so) - purple
so=38;5;176

# Named pipe (pi) - orange
pi=38;5;172

# Setuid (su) - red
su=38;5;167

# Setgid (sg) - red
sg=38;5;167

# Other-writable directory (ow) - green foreground on dark background
ow=38;5;107;48;5;236

# Sticky and other-writable directory (tw) - green foreground on dark background
tw=38;5;107;48;5;236

# Sticky directory (st) - green
st=38;5;107

# Orphaned symbolic link (or) - red
or=38;5;167

# Multi-hardlink file (mh) - blue
mh=38;5;74

# File extensions (example, extend as needed)
# Archives - blue
.zip=38;5;74
.tar=38;5;74
.gz=38;5;74
.rar=38;5;74

# Images - purple
.jpg=38;5;176
.png=38;5;176
.gif=38;5;176

# Audio - aqua
.mp3=38;5;109
.flac=38;5;109
.wav=38;5;109

# Text files - default foreground
.txt=38;5;252
.md=38;5;252

# Configuration files - yellow
.conf=38;5;179
.ini=38;5;179
.yml=38;5;179
.yaml=38;5;179

# Shell scripts - green
.sh=38;5;107
.bash=38;5;107
.zsh=38;5;107
.fish=38;5;107

# Log files - grey
.log=38;5;244
