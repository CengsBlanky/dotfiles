# global config
set watch true
set number true
set relativenumber true
set incsearch true
set timefmt "󱫙 2006-01-02 15:04 Mon"
set icons true
set truncatechar "*"
map <c-j> page-down
map <c-k> page-up
nmap <space> :toggle
set ifs "\n"
set previewer ~/.config/lf/previewer
set cleaner ~/.config/lf/cleaner

### USAGE ###
# copy (default y) command copies the current file or selections
# cut (default d) command cuts the current file or selections
# paste (default p) command pastes the copied or cut files to the current directory
# clear (default c) command clears copied or cut files

# extract the current file with the right command
# (xkcd link: https://xkcd.com/1168/)
cmd decompress ${{
    set -f
    case $f in
        *.tar.bz|*.tar.bz2|*.tbz|*.tbz2) tar xjvf $f;;
        *.tar.gz|*.tgz) tar xzvf $f;;
        *.tar.xz|*.txz) tar xJvf $f;;
        *.zip) unzip $f;;
        *.rar) unrar x $f;;
        *.7z) 7z x $f;;
    esac
}}
# compress current file or selected files with tar and gunzip
cmd compress ${{
    set -f
    mkdir $1
    cp -r $fx $1
    tar czf $1.tar.gz $1
    rm -rf $1
}}
# compress current file or selected files with zip
cmd zip ${{
    set -f
    mkdir $1
    cp -r $fx $1
    zip -r $1.zip $1
    rm -rf $1
}}
# open dir or file with xdg-open
cmd open &{{
    case $(file --mime-type -Lb "$f") in
        text/*|inode/x-empty)
            lf -remote "send $id \$$EDITOR \$fx"
            ;;
        *)
            for f in $fx; do $OPENER $f > /dev/null 2> /dev/null & done
            ;;
    esac
}}

# batch create and edit files
cmd touch %{{
    IFS=" "
    touch -- "$@"
}}

# remove all visual or selected files
cmd eliminate %{{
    set -- $fv
    count=$#

    if [ $count -eq 0 ]; then
        set -- $fx
        count=$#
    fi

    if [ $count -eq 1 ]; then
        target="$1"
        echo "Delete file $target? (y/N): "
    else
        echo "Delete $count files? (y/N): "
    fi

    read -r confirm

    case "$confirm" in
        [yY]|[yY][eE][sS])
            # Use rm -rf for safety with directories; adjust flags if needed
            rm -rf -- "$@"
            ;;
        *)
            echo "Aborted." >&2
            ;;
    esac
    lf -remote "send $id :visual-discard"
}}

# cut all visually covered files
cmd cutselect %{{
    set -- $fv
    count=$#
    if [ $count -eq 0 ]; then
        set -- $fx
        count=$#
    else
        declare -A fs_items
        for item in "${fs[@]}"; do
            fs_items["$item"]=1
        done
        while read -r file; do
            if [[ -z "${fs_items["$file"]}" ]]; then
                lf -remote "send $id toggle \"$file\""
            fi
        done <<< "$fv"
        lf -remote "send $id :visual-discard"
    fi

    lf -remote "send $id :cut"
    if [ $count -eq 1 ]; then
        echo "cut file: $1"
    else
        echo "cut $count files"
    fi
}}

cmd bulk-rename ${{
    old="$(mktemp)"
    new="$(mktemp)"
    if [ -n "$fs" ]; then
        fs="$(basename -a -- $fs)"
    elif [ -n "$fv" ]; then
        fs="$(basename -a -- $fv)"
    else
        fs="$(ls)"
    fi
    printf '%s\n' "$fs" > "$old"
    printf '%s\n' "$fs" > "$new"
    $EDITOR "$new"
    [ "$(wc -l < "$new")" -ne "$(wc -l < "$old")" ] && exit
    paste "$old" "$new" | while IFS= read -r names; do
        src="$(printf '%s' "$names" | cut -f1)"
        dst="$(printf '%s' "$names" | cut -f2)"
        if [ "$src" = "$dst" ] || [ -e "$dst" ]; then
            continue
        fi
        mv -- "$src" "$dst"
    done
    rm -- "$old" "$new"
    lf -remote "send $id unselect"
    lf -remote "send $id visual-discard"
}}

cmd visual-toggle &{{
    while read -r file; do
        lf -remote "send $id toggle \"$file\""
    done <<< "$fv"
    lf -remote "send $id visual-discard"
}}

map D eliminate
map <enter> open
map o open
map l open
map w push :touch<space>
map a :push %mkdir<space>
map R bulk-rename
vmap <space> visual-toggle
vmap d cutselect
map c cutselect
vmap c cutselect
