{
  "main class template": {
    "isFileTemplate": true,
    "prefix": [
      "cmain"
    ],
    "body": [
      "public class $TM_FILENAME_BASE {",
      "\tpublic static void main(String[] args) {",
      "\t\t$0",
      "\t}",
      "}"
    ]
  },
  "print to stdout": {
    "prefix": [
      "sout"
    ],
    "body": [
      "System.out.println($0);"
    ]
  },
  "print to stdout with format": {
    "prefix": [
      "souf"
    ],
    "body": [
      "System.out.printf($0);"
    ]
  }
}
