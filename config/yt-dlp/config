# proxy
--proxy localhost:7890
--remote-components ejs:npm
# Download best mp4 format no better than 1080p available or any other best if no mp4 available
--format bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best+bestvideo[height<=1080]
# only extract audio
# --extract-audio --audio-format mp3 --audio-quality 0
# save directory
-o ~/Videos/youtube/%(title)s.%(ext)s
# -o ~/Music/%(title)s.%(ext)s
