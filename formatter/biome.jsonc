{
  "formatter": {
    "indentStyle": "space", // default is `tab`
    "lineWidth": 80 // default is `80`
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double", // default is `double`
      "lineWidth": 80, // override `formatter.lineWidth`
      "arrowParentheses": "asNeeded"
    },
    "linter": {
      "enabled": false
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "html": {
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentScriptAndStyle": true,
      "bracketSameLine": true
    }
  }
}
