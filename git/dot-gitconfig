[pull]
    rebase = false
[init]
	defaultBranch = main
[push]
    default = simple
[color]
    status = always
    diff = auto
    branch = always
    interactive = always
[grep]
    lineNumber = true
    patternType = perl
[branch]
    sort = -committerdate
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
