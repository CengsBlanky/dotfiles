#!/bin/bash
xset -b # disable bell
eval `/usr/bin/ssh-agent`
# xmodmap ~/.Xmodmap
# set wallpaper
picom --backend glx --vsync &
feh --bg-fill ~/Pictures/wallpaper/pexels-eberhardgross-1612351.jpg &
# set status bar
while true
do
	LOCALTIME=$(date '+%Y-%m-%d %H:%M')
    STATUS=$(cat /sys/class/power_supply/BAT1/status)
    BAT_PERCENT=$(cat /sys/class/power_supply/BAT1/capacity)
    BAT=""
    if [ "$STATUS" = "Discharging" ]; then
        BAT="🔋$BAT_PERCENT%"
    fi
    xsetroot -name "$BAT 🗓 $LOCALTIME"
	sleep 30s
done &
exec dwm
